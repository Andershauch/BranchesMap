DATABASE_URL="postgresql://user:password@host/database?sslmode=verify-full&channel_binding=require"
# Required in production. Must be a long random value and rotated through deployment secrets, not in git.
AUTH_SECRET="replace-with-a-long-random-secret"
# Required until the first superadmin has been created through the one-time setup flow.
SUPERADMIN_SETUP_SECRET="replace-with-a-long-random-one-time-setup-secret"
# Required when sending invitation emails.
RESEND_API_KEY="replace-with-resend-api-key"
# Sender identity. In production, use an address on a verified Resend domain.
MAIL_FROM="JOBVEJ <jobvej@mail.hansendjurhuus.dk>"
# Optional address used when recipients reply to transactional emails.
MAIL_REPLY_TO="reply@example.com"
# Legacy sender variable remains supported for existing deployments.
# APP_MAIL_FROM="JOBVEJ <onboarding@resend.dev>"
# Canonical production origin used for redirects, follow checks, and trusted same-origin validation.
APP_BASE_URL="https://your-app.example.com"
# Optional fixed kiosk origin for travel estimates shown in kiosk mode.
KIOSK_TRAVEL_ORIGIN_LATITUDE="55.2296"
KIOSK_TRAVEL_ORIGIN_LONGITUDE="11.7607"
ENABLE_LIVE_JOB_ESTIMATES="true"
FOLLOW_CHECK_SECRET="replace-with-a-long-random-secret"
JOBINDSATS_API_TOKEN="replace-with-api-token"

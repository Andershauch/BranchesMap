* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.ts text working-tree-encoding=UTF-8
*.tsx text working-tree-encoding=UTF-8
*.js text working-tree-encoding=UTF-8
*.mjs text working-tree-encoding=UTF-8
*.cjs text working-tree-encoding=UTF-8
*.json text working-tree-encoding=UTF-8
*.md text working-tree-encoding=UTF-8
*.html text working-tree-encoding=UTF-8
*.css text working-tree-encoding=UTF-8
*.scss text working-tree-encoding=UTF-8
*.prisma text working-tree-encoding=UTF-8
*.yml text working-tree-encoding=UTF-8
*.yaml text working-tree-encoding=UTF-8
*.toml text working-tree-encoding=UTF-8
*.sql text working-tree-encoding=UTF-8
*.txt text working-tree-encoding=UTF-8

# --- line-ending hygiene pass ---
# Binary assets, declared explicitly rather than left to git's content
# sniffing, because eol normalisation would silently corrupt them.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.zip binary
*.pdf binary
*.wav binary
*.mp3 binary
*.mp4 binary
*.opus binary
*.db binary

# Webfonts. eol normalisation would corrupt a font file, so never
# let content sniffing decide.
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
